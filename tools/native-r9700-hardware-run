#!/bin/sh
# Supervise the shared TinyGPU server around one hardware command.
#
# Usage: native-r9700-hardware-run [<socket>] <command> [args...]
#
# $1 is the TinyGPU socket path (the canonical default is used when unset);
# the remaining argv is the command to run. The wrapper guarantees exactly one
# TinyGPU server owns the socket before the command runs, removes a stale
# socket when no live owner holds it, and never kills a live server. Server
# startup is serialized by flock(2) on ~/.cache/native-r9700/hardware.lock so
# two invocations cannot both spawn a server on the same socket. That lock is
# released before the command runs: the command's own
# native_r9700::HardwareLock takes the same lock file for the hardware command,
# and holding both at once would self-deadlock.

set -eu

DEFAULT_SOCKET="${TMPDIR}/tinygpu.sock"
SERVER_BIN="/Applications/TinyGPU.app/Contents/MacOS/TinyGPU"
PYTHON="${HOME}/.pyenv/versions/3.12.8/bin/python3"
LOCK_DIR="${HOME:?HOME is required}/.cache/native-r9700"
LOCK_FILE="$LOCK_DIR/hardware.lock"

SOCKET="$DEFAULT_SOCKET"
if [ "$#" -ge 1 ]; then
  SOCKET="${1:-$DEFAULT_SOCKET}"
  shift
fi

if [ "$#" -eq 0 ]; then
  echo "native-r9700-hardware-run: no command to run" >&2
  exit 2
fi

mkdir -p "$LOCK_DIR"

# Serialized server supervision. The embedded Python acquires flock on the
# hardware lock, starts or attaches the TinyGPU server, waits for readiness,
# then releases the lock (its exit releases the flock) before the command runs.
"$PYTHON" - "$SOCKET" "$SERVER_BIN" "$LOCK_FILE" <<'PY'
import fcntl
import os
import subprocess
import sys
import time

socket_path, server_bin, lock_file = sys.argv[1], sys.argv[2], sys.argv[3]
lock_fd = open(lock_file, "a+")
fcntl.flock(lock_fd, fcntl.LOCK_EX)
try:
    owner = subprocess.run(
        ["pgrep", "-f", "TinyGPU server " + socket_path],
        capture_output=True,
        text=True,
    )
    if owner.stdout.strip():
        # A live server already owns the socket; wait for the socket to appear.
        for _ in range(100):
            if os.path.exists(socket_path):
                break
            time.sleep(0.1)
        if not os.path.exists(socket_path):
            sys.stderr.write(
                "native-r9700-hardware-run: live TinyGPU owner has no socket at "
                + socket_path + "\n")
            sys.exit(1)
    else:
        # No live owner: any socket file is stale — remove it, then start the
        # server detached so it outlives this wrapper (never killed here).
        try:
            os.unlink(socket_path)
        except FileNotFoundError:
            pass
        subprocess.Popen(
            [server_bin, "server", socket_path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        for _ in range(100):
            if os.path.exists(socket_path):
                break
            time.sleep(0.1)
        if not os.path.exists(socket_path):
            sys.stderr.write(
                "native-r9700-hardware-run: TinyGPU server did not become ready at "
                + socket_path + "\n")
            sys.exit(1)
finally:
    fcntl.flock(lock_fd, fcntl.LOCK_UN)
    lock_fd.close()
PY

exec "$@"
